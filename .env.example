# Copie este archivo como .env.local y complete los valores.
# Sin estas variables el formulario sigue funcionando: ofrece copiar la
# solicitud o enviarla por WhatsApp/correo si esos datos están en content.ts.

# Clave de API de https://resend.com
RESEND_API_KEY=

# Correo de la empresa que recibe las solicitudes de cotización
COTIZACION_DESTINO=

# Remitente con dominio verificado en Resend
COTIZACION_REMITENTE="ESCRISUR <web@escrisur.pe>"
